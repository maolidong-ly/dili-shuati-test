# 生产：Supabase 项目 Settings → API
VITE_SUPABASE_URL=https://gozbacpxkwcopzfypzuh.supabase.co
# 新版为 sb_publishable_…；旧版 Legacy 为 eyJ… 的 anon public，填到 VITE_SUPABASE_ANON_KEY 均可
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# 建库时设的数据库密码（仅本机脚本建表用，不要提交 git）
SUPABASE_DB_PASSWORD=

# 发给学生的班级口令（脚本会写入 Supabase app_secrets）
ACCESS_PASSPHRASE=

# 仅本地调试、未接 Supabase 时使用（不要用于生产）
VITE_DEV_ACCESS_PASSPHRASE=dev-only-passphrase
